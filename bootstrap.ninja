# SPDX-License-Identifier: GPL-2.0-only
# tools/buildutil/bootstrap.ninja — FROZEN. Regenerate: buildutil gen
# Stage 0 builds minibuildutil; minibuildutil realizes the full native frontend.
builddir = .buildutil/tmp/bootstrap-ninja
rule rustcid
  command = outdir=$$(dirname $out) && mkdir -p $$outdir && tmp=$out.tmp.$$$$ && { printf 'rustc-command: %s\n' "$${BUILDUTIL_RUSTC:-rustc}"; command -v "$${BUILDUTIL_RUSTC:-rustc}" 2>/dev/null | sed 's/^/rustc-path: /'; "$${BUILDUTIL_RUSTC:-rustc}" -vV; printf 'linker-command: %s\n' "$${BUILDUTIL_LINKER:-cc}"; command -v "$${BUILDUTIL_LINKER:-cc}" 2>/dev/null | sed 's/^/linker-path: /'; "$${BUILDUTIL_LINKER:-cc}" --version 2>/dev/null || true; } > $$tmp && if test -f $out && cmp -s $out $$tmp; then rm $$tmp; else mv $$tmp $out; fi
  description = BOOTSTRAP $out
  restat = 1
rule inputcheckc
  command = $${BUILDUTIL_RUSTC:-rustc} --edition=2024 -O -o $out $in
  description = BOOTSTRAP $out
rule micac
  command = $${BUILDUTIL_RUSTC:-rustc} --edition=2024 -O --crate-type=lib --crate-name=mica -o $out $in
  description = BOOTSTRAP $out
rule minibuildutilc
  command = $${BUILDUTIL_RUSTC:-rustc} --edition=2024 -O --extern mica=$mica_rlib -L $mica_dir -o $out $in
  description = BOOTSTRAP $out
rule selfhost
  command = $minibuildutil --repo-root "$${BUILDUTIL_SELFHOST_REPO_ROOT:-.}" --state-root "$${BUILDUTIL_SELFHOST_STATE_ROOT:-.buildutil}" --rustc "$${BUILDUTIL_RUSTC:-rustc}" --linker "$${BUILDUTIL_LINKER:-cc}" --rustc-identity $rustc_identity --output $out --exec-host $exec_host
  description = SELFHOST $out
rule bootstrap_no_default
  command = echo 'bootstrap: use ./buildutil, or name .buildutil/bootstrap/<exec-host>/buildutil explicitly' >&2; false
  description = BOOTSTRAP select host
build FORCE: phony
build bootstrap-select-host: bootstrap_no_default
build .buildutil/bootstrap/x86_64-apple-darwin/rustc.vv: rustcid FORCE
build .buildutil/bootstrap/x86_64-apple-darwin/inputcheck: inputcheckc tools/buildutil/inputcheck.rs | .buildutil/bootstrap/x86_64-apple-darwin/rustc.vv $
    tools/buildutil/inputs/bootstrap.rs $
    tools/buildutil/inputs/codec.rs $
    tools/buildutil/inputs/content.rs $
    tools/buildutil/source/filter.rs $
    tools/buildutil/spec/toml.rs $
    tools/buildutil/glob/mod.rs $
    tools/buildutil/lib/crypto/sha256.rs
build .buildutil/bootstrap/x86_64-apple-darwin/libmica.rlib: micac tools/buildutil/lib/mica/lib.rs | .buildutil/bootstrap/x86_64-apple-darwin/rustc.vv $
    tools/buildutil/lib/mica/ast.rs $
    tools/buildutil/lib/mica/eval.rs $
    tools/buildutil/lib/mica/lexer.rs $
    tools/buildutil/lib/mica/parser.rs $
    tools/buildutil/lib/mica/tests.rs $
    tools/buildutil/lib/mica/vercmp.rs
build .buildutil/bootstrap/x86_64-apple-darwin/minibuildutil: minibuildutilc tools/buildutil/minibuildutil.rs | .buildutil/bootstrap/x86_64-apple-darwin/libmica.rlib .buildutil/bootstrap/x86_64-apple-darwin/rustc.vv $
    tools/buildutil/crypto/crc.rs $
    tools/buildutil/crypto/detseed.rs $
    tools/buildutil/crypto/ed25519.rs $
    tools/buildutil/crypto/mod.rs $
    tools/buildutil/crypto/sha512.rs $
    tools/buildutil/eval/cache.rs $
    tools/buildutil/eval/graph.rs $
    tools/buildutil/eval/mod.rs $
    tools/buildutil/eval/ninja_emit.rs $
    tools/buildutil/eval/observe.rs $
    tools/buildutil/eval/plan/bootstrap.rs $
    tools/buildutil/eval/plan/check.rs $
    tools/buildutil/eval/plan/mod.rs $
    tools/buildutil/eval/plan/tests.rs $
    tools/buildutil/eval/plan/wire.rs $
    tools/buildutil/events/mod.rs $
    tools/buildutil/exec/build.rs $
    tools/buildutil/exec/builder.rs $
    tools/buildutil/exec/depinfo.rs $
    tools/buildutil/exec/env.rs $
    tools/buildutil/exec/inflate.rs $
    tools/buildutil/exec/input_fetch.rs $
    tools/buildutil/exec/jobserver.rs $
