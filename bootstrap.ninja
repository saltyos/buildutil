    tools/buildutil/tools/mod.rs $
    tools/buildutil/lib/crypto/sha256.rs $
    tools/buildutil/sdk/wire.rs
  mica_rlib = .buildutil/bootstrap/x86_64-apple-darwin/libmica.rlib
  mica_dir = .buildutil/bootstrap/x86_64-apple-darwin
build .buildutil/bootstrap/x86_64-apple-darwin/buildutil: selfhost .buildutil/bootstrap/x86_64-apple-darwin/minibuildutil .buildutil/bootstrap/x86_64-apple-darwin/rustc.vv FORCE
  minibuildutil = .buildutil/bootstrap/x86_64-apple-darwin/minibuildutil
  rustc_identity = .buildutil/bootstrap/x86_64-apple-darwin/rustc.vv
  exec_host = x86_64-apple-darwin
